# Same-origin API requests are forwarded by Vite during development/preview.
VITE_API_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000
# Production: route /api to FastAPI at your reverse proxy, or set VITE_API_URL
# to a public HTTPS API base URL and allow the frontend origin in backend CORS_ORIGINS.
